<Window x:Class="SerialDebugPanel.ProjectManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Project Configuration" Height="500" Width="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F8FAFC" WindowStyle="None" AllowsTransparency="True" BorderThickness="1" BorderBrush="#E2E8F0">

    <Window.Resources>
        <!-- استایل دکمه‌های اصلی -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- هدر -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="STM32 Dashboard Manager" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Choose a project profile to load or manage configurations." FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>
            <!-- دکمه بستن سریع پنجره -->
            <Button Grid.Column="1" Content="✕" Width="28" Height="28" Background="#EF4444" 
                    Style="{StaticResource ModernBtn}" Click="CloseBtn_Click" VerticalAlignment="Top"/>
        </Grid>

        <!-- لیست پروژه‌ها -->
        <Border Grid.Row="1" Background="White" BorderThickness="1" BorderBrush="#E2E8F0" CornerRadius="8" Padding="5">
            <ListBox x:Name="ProjectsListBox" BorderThickness="0" Background="Transparent" 
                     ScrollViewer.VerticalScrollBarVisibility="Auto" 
                     HorizontalContentAlignment="Stretch"
                     MouseDoubleClick="ProjectsListBox_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="10,8" Background="Transparent">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- ستون سمت چپ: اطلاعات متن کاملا جدا -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,15,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#1E293B"/>
                                    <TextBlock Text="{Binding Path}" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- ستون سمت راست: دکمه حذف به بیرونی‌ترین سمت چسبیده است -->
                                <Button Grid.Column="1" Content="Delete" 
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}" 
                                        Background="#EF4444" Width="60" Height="26" FontSize="10" 
                                        Style="{StaticResource ModernBtn}" 
                                        VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- دکمه‌های مدیریتی پایین صفحه (سه دکمه هم‌اندازه) -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- دکمه باز کردن پوشه پروژه در اکسپلورر -->
            <Button x:Name="LocateFolderBtn" Grid.Column="0" Content="Locate Folder" Background="#64748B" Margin="0,0,4,0" Style="{StaticResource ModernBtn}" Click="LocateFolderBtn_Click"/>

            <!-- دکمه ورود اطلاعات جدید -->
            <Button x:Name="ImportBtn" Grid.Column="1" Content="Import JSON" Background="#10B981" Margin="4,0,4,0" Style="{StaticResource ModernBtn}" Click="ImportBtn_Click"/>

            <!-- دکمه تایید لود -->
            <Button x:Name="LoadBtn" Grid.Column="2" Content="Load Selected" Background="#2563EB" Margin="4,0,0,0" Style="{StaticResource ModernBtn}" Click="LoadBtn_Click"/>
        </Grid>
    </Grid>
</Window>
