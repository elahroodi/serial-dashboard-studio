<Window x:Class="SerialDebugPanel.ConfiguratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SerialDebugPanel"
        Title="JSON Config Generator &amp; Editor" Height="820" Width="1200" 
        WindowStartupLocation="CenterScreen" Background="#F1F5F9"
        FontFamily="Segoe UI" Icon="{x:Null}">

    <Window.Resources>
        <local:NullToCollapsingConverter x:Key="NullToCollapsing"/>

        <!-- استایل دکمه‌های فرم -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Background" Value="#EF4444"/>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Background" Value="#10B981"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Background" Value="#64748B"/>
        </Style>

        <!-- استایل تکست باکس‌ها -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- بخش چپ: فرم ورود اطلاعات پویا / ویرایش اطلاعات -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="1" Opacity="0.02"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock x:Name="lblFormTitle" Text="Add Interface Item" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock x:Name="lblFormSubtitle" Text="Configure dynamic widgets below" FontSize="11" Foreground="#64748B"/>
                    <Separator Margin="0,10,0,0" Background="#E2E8F0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <StackPanel>
                        <!-- دسته بندی اصلی -->
                        <Label Content="Category:"/>
                        <ComboBox x:Name="cmbCategory" Height="32" SelectionChanged="CmbCategory_SelectionChanged">
                            <ComboBoxItem Content="Control Widget" IsSelected="True"/>
                            <ComboBoxItem Content="Monitor Widget"/>
                        </ComboBox>

                        <!-- نوع آیتم -->
                        <Label Content="Widget Type (Type):"/>
                        <ComboBox x:Name="cmbType" Height="32" SelectionChanged="CmbType_SelectionChanged"/>

                        <!-- برچسب -->
                        <Label Content="Widget Label:"/>
                        <TextBox x:Name="txtLabel"/>

                        <!-- فیلد مخصوص کنترلرها -->
                        <StackPanel x:Name="panelCommand">
                            <Label Content="Serial Protocol Command:"/>
                            <TextBox x:Name="txtCommand"/>
                        </StackPanel>

                        <!-- فیلد مخصوص مانیتورها -->
                        <StackPanel x:Name="panelVariable">
                            <Label Content="System Variable Key:"/>
                            <TextBox x:Name="txtVariable"/>
                        </StackPanel>

                        <!-- پارامترهای عددی صحیح (int) -->
                        <StackPanel x:Name="panelIntParams" Visibility="Collapsed">
                            <Label Content="Minimum (Min):"/>
                            <TextBox x:Name="txtMin" Text="0"/>
                            <Label Content="Maximum (Max):"/>
                            <TextBox x:Name="txtMax" Text="100"/>
                            <Label Content="Default Value (Int):"/>
                            <TextBox x:Name="txtDefaultInt" Text="50"/>
                        </StackPanel>

                        <!-- پارامترهای اعشاری (float/numeric) -->
                        <StackPanel x:Name="panelFloatParams" Visibility="Collapsed">
                            <Label Content="Min Float:"/>
                            <TextBox x:Name="txtMinFloat" Text="0.0"/>
                            <Label Content="Max Float:"/>
                            <TextBox x:Name="txtMaxFloat" Text="5.0"/>
                            <Label Content="Default Float:"/>
                            <TextBox x:Name="txtDefaultFloat" Text="3.3"/>
                            <Label Content="Step Resolution:"/>
                            <TextBox x:Name="txtStep" Text="0.1"/>
                            <Label Content="Decimal Places (Decimals):"/>
                            <TextBox x:Name="txtDecimals" Text="1"/>
                        </StackPanel>

                        <!-- پارامترهای متفرقه عمومی -->
                        <StackPanel x:Name="panelCommonParams" Visibility="Collapsed">
                            <Label Content="Measurement Unit (e.g., %, V, °C):"/>
                            <TextBox x:Name="txtUnit"/>
                        </StackPanel>

                        <!-- فیلدهای تخصصی انواع پیشرفته تر -->
                        <!-- ۱. دکمه ساده یا اینپوت -->
                        <StackPanel x:Name="panelTextButtonParams" Visibility="Collapsed">
                            <Label Content="Button / Default Text:"/>
                            <TextBox x:Name="txtCustomText"/>
                        </StackPanel>

                        <!-- ۲. سلکتور چند گزینه‌ای -->
                        <StackPanel x:Name="panelDropdownParams" Visibility="Collapsed">
                            <Label Content="Dropdown Options (Label:Value, Label2:Value2):"/>
                            <TextBox x:Name="txtDropdownOptions" ToolTip="Format -> Auto:auto, Manual:manual"/>
                            <Label Content="Default Selected Option:"/>
                            <TextBox x:Name="txtDefaultOption" Text="auto"/>
                        </StackPanel>

                        <!-- ۳. پنل آلارم / ال ای دی بیتی -->
                        <StackPanel x:Name="panelAlarmsParams" Visibility="Collapsed">
                            <Label Content="Bitmapping (Names/Alarms) (0:PWR, 1:RUN, 2:ERR):"/>
                            <TextBox x:Name="txtAlarmsMap" ToolTip="Format -> 1:OverTemp, 2:OverVolt"/>
                        </StackPanel>

                        <!-- ۴. جدول ستون‌ها -->
                        <StackPanel x:Name="panelTableParams" Visibility="Collapsed">
                            <Label Content="Table Columns (comma separated):"/>
                            <TextBox x:Name="txtTableColumns" Text="ax,ay,az"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- دکمه‌های کنترل فرم -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Button x:Name="btnSubmit" Content="Add to Configuration" Click="BtnAdd_Click" Style="{StaticResource AccentButton}"/>
                    <Button x:Name="btnCancelEdit" Content="Cancel Edit Mode" Click="BtnCancelEdit_Click" Style="{StaticResource SecondaryButton}" Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- بخش راست: ابزار بارگذاری پروژه و جداول خروجی -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
                <!-- دکمه‌های جابه‌جایی کنترل‌ها -->
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
                <!-- دکمه‌های جابه‌جایی مانیتورها -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- بخش لود سریع فایل‌های موجود در Configs -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Load Config File:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,10,0"/>
                    <ComboBox x:Name="cmbConfigFiles" Grid.Column="1" Height="32"/>
                    <Button Grid.Column="2" Content="Load File" Click="BtnLoadConfig_Click" Width="100" Margin="10,0,0,0" Style="{StaticResource AccentButton}"/>
                </Grid>
            </Border>

            <!-- لیست کنترل‌ها -->
            <GroupBox Header="Configured Controls (Double-click or click row to load and edit)" Grid.Row="1" Margin="0,0,0,6" Foreground="#1E293B" FontWeight="Bold" BorderBrush="#E2E8F0">
                <DataGrid x:Name="dgControls" AutoGenerateColumns="False" CanUserAddRows="False" 
                          Background="White" BorderThickness="0" GridLinesVisibility="Horizontal" RowHeight="32" 
                          HeadersVisibility="Column" RowDetailsVisibilityMode="VisibleWhenSelected"
                          MouseDoubleClick="DgControls_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60" IsReadOnly="True"/>
                    </DataGrid.Columns>

                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,1" Padding="12">
                                <WrapPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,24,0" Visibility="{Binding Min, Converter={StaticResource NullToCollapsing}}">
                                        <TextBlock Text="Range (Int):" FontWeight="Bold" Foreground="#64748B" FontSize="10"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="Min: " Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding Min}" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,10,0"/>
                                            <TextBlock Text="Max: " Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding Max}" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,10,0"/>
                                            <TextBlock Text="Default: " Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding DefaultInt}" FontWeight="SemiBold" Foreground="#0F172A"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,24,0" Visibility="{Binding MinFloat, Converter={StaticResource NullToCollapsing}}">
                                        <TextBlock Text="Range (Float):" FontWeight="Bold" Foreground="#64748B" FontSize="10"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="Min: " Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding MinFloat}" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,10,0"/>
                                            <TextBlock Text="Max: " Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding MaxFloat}" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,10,0"/>
                                            <TextBlock Text="Step: " Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding Step}" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,10,0"/>
                                            <TextBlock Text="Default: " Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding DefaultFloat}" FontWeight="SemiBold" Foreground="#0F172A"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,24,0" Visibility="{Binding ButtonText, Converter={StaticResource NullToCollapsing}}">
                                        <TextBlock Text="Button Text:" FontWeight="Bold" Foreground="#64748B" FontSize="10"/>
                                        <TextBlock Text="{Binding ButtonText}" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,24,0" Visibility="{Binding DefaultText, Converter={StaticResource NullToCollapsing}}">
                                        <TextBlock Text="Default Input Text:" FontWeight="Bold" Foreground="#64748B" FontSize="10"/>
                                        <TextBlock Text="{Binding DefaultText}" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,24,0" Visibility="{Binding DefaultOption, Converter={StaticResource NullToCollapsing}}">
                                        <TextBlock Text="Dropdown Configuration:" FontWeight="Bold" Foreground="#64748B" FontSize="10"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="Default Option: " Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding DefaultOption}" FontWeight="SemiBold" Foreground="#10B981" Margin="0,0,12,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </WrapPanel>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
            </GroupBox>

            <!-- دکمه‌های جابه‌جایی برای لیست کنترل‌ها -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                <Button Content="▲ Up" Click="MoveControlUp" Width="80" Style="{StaticResource SecondaryButton}" Margin="4"/>
                <Button Content="▼ Down" Click="MoveControlDown" Width="80" Style="{StaticResource SecondaryButton}" Margin="4"/>
            </StackPanel>

            <!-- لیست مانیتورها -->
            <GroupBox Header="Configured Monitors (Double-click or click row to load and edit)" Grid.Row="3" Margin="0,6,0,0" Foreground="#1E293B" FontWeight="Bold" BorderBrush="#E2E8F0">
                <DataGrid x:Name="dgMonitors" AutoGenerateColumns="False" CanUserAddRows="False" 
                          Background="White" BorderThickness="0" GridLinesVisibility="Horizontal" RowHeight="32" 
                          HeadersVisibility="Column" RowDetailsVisibilityMode="VisibleWhenSelected"
                          MouseDoubleClick="DgMonitors_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Variable Key" Binding="{Binding Variable}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60" IsReadOnly="True"/>
                    </DataGrid.Columns>

                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,1" Padding="12">
                                <WrapPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,24,0" Visibility="{Binding Columns, Converter={StaticResource NullToCollapsing}}">
                                        <TextBlock Text="Table Columns:" FontWeight="Bold" Foreground="#64748B" FontSize="10"/>
                                        <TextBlock Text="{Binding Columns.Count}" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,24,0" Visibility="{Binding Names, Converter={StaticResource NullToCollapsing}}">
                                        <TextBlock Text="LED Bit-Mapping (State Names):" FontWeight="Bold" Foreground="#64748B" FontSize="10"/>
                                        <TextBlock Text="{Binding Names.Count, StringFormat='\{0\} bits defined'}" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,24,0" Visibility="{Binding Alarms, Converter={StaticResource NullToCollapsing}}">
                                        <TextBlock Text="Alarm Map Configuration:" FontWeight="Bold" Foreground="#64748B" FontSize="10"/>
                                        <TextBlock Text="{Binding Alarms.Count, StringFormat='\{0\} alarms defined'}" FontWeight="SemiBold" Foreground="#EF4444" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </WrapPanel>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
            </GroupBox>

            <!-- دکمه‌های جابه‌جایی برای لیست مانیتورها (جدید) -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4">
                <Button Content="▲ Up" Click="MoveMonitorUp" Width="80" Style="{StaticResource SecondaryButton}" Margin="4"/>
                <Button Content="▼ Down" Click="MoveMonitorDown" Width="80" Style="{StaticResource SecondaryButton}" Margin="4"/>
            </StackPanel>

            <!-- دکمه‌های پایانی پایینی -->
            <Grid Grid.Row="5" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Remove Selected Row" Click="BtnDelete_Click" Style="{StaticResource DangerButton}" Width="180"/>
                <Button Grid.Column="3" Content="Save Configuration (JSON)" Click="BtnSaveJson_Click" Style="{StaticResource SuccessButton}" Width="220" FontWeight="Bold"/>
            </Grid>
        </Grid>
    </Grid>
</Window>